PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://smp:smp@localhost:5432/staff_portal?schema=public
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-long-random-pepper
OTP_TTL_SECONDS=300
OTP_LENGTH=6
PASSWORD_RESET_TTL_SECONDS=3600

# Next.js origin allowed to call this API. Use * to allow all origins.
CORS_ORIGIN=*

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_PRESIGN_EXPIRES_SECONDS=300
