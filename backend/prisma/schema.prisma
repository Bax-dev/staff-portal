generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  OFFICER
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
}

enum DocumentCategory {
  STAFF_REGISTER
  IDENTITY
  SERVICE_HISTORY
}

enum ServiceHistoryType {
  PROMOTION
  POSTING
  TRANSFER
  LEAVE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  IMPORT
  ARCHIVE
  UNARCHIVE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         UserRole  @default(OFFICER)
  photo        String?
  theme        String    @default("light")
  fontSize     String    @default("medium") @map("font_size")
  staffId      String?   @unique
  staff         Staff?         @relation(fields: [staffId], references: [id])
  notifications Notification[]
  auditLogs     AuditLog[]
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([deletedAt])
}

model Department {
  id        String       @id @default(uuid())
  name      String       @unique
  parentId  String?
  parent    Department?  @relation("DepartmentTree", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentTree")
  staff     Staff[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Staff {
  id              String      @id @default(uuid())
  staffCode       String      @unique @map("staff_id")
  name            String
  designation     String
  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])
  email           String
  phone           String
  gender          String
  status          StaffStatus @default(ACTIVE)
  grade           String
  appointmentDate DateTime
  location        String
  nationality     String      @default("Nigerian")
  dateOfBirth     DateTime?
  maritalStatus   String      @default("Not specified")
  nin             String?
  tin             String?
  pensionPin      String?
  bankName        String?
  accountNumber   String?
  bvn             String?
  ippis           String?
  pfa             String?
  bloodGroup      String?
  genotype        String?
  medicalFitness  String?
  photo             String?
  user              User?
  documents         Document[]
  serviceHistory    ServiceHistory[]
  nextOfKin         NextOfKin[]
  education         Education[]
  certifications    Certification[]
  familyMembers     FamilyMember[]
  emergencyContacts EmergencyContact[]
  archivedAt        DateTime?
  deletedAt         DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([departmentId])
  @@index([status])
  @@index([name])
  @@index([archivedAt])
  @@index([deletedAt])
}

model Document {
  id        String           @id @default(uuid())
  staffId   String?
  staff     Staff?           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  category  DocumentCategory
  title     String
  fileName  String
  fileUrl   String
  mimeType  String
  deletedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([staffId])
  @@index([category])
  @@index([deletedAt])
}

model ServiceHistory {
  id            String             @id @default(uuid())
  staffId       String
  staff         Staff              @relation(fields: [staffId], references: [id], onDelete: Cascade)
  type          ServiceHistoryType
  title         String
  details       String?
  effectiveDate DateTime
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model NextOfKin {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  address      String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model Education {
  id            String    @id @default(uuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  institution   String
  qualification String
  fieldOfStudy  String?
  startDate     DateTime?
  endDate       DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model Certification {
  id                  String    @id @default(uuid())
  staffId             String
  staff               Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name                String
  issuer              String
  issuedDate          DateTime?
  expiryDate          DateTime?
  certificateNumber   String?
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model FamilyMember {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  dateOfBirth  DateTime?
  gender       String?
  phone        String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model EmergencyContact {
  id           String    @id @default(uuid())
  staffId      String
  staff        Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  address      String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([staffId])
  @@index([deletedAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  readAt    DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([deletedAt])
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  actorEmail String?
  action     AuditAction
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Settings {
  id                  String   @id @default(uuid())
  organizationName    String   @default("Planning and Design Directorate")
  defaultExportFormat String   @default("XLSX")
  updatedAt           DateTime @updatedAt
}
